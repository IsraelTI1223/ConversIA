# ==========================================
# ConversIA API - Environment Variables
# ==========================================

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
# Local:
DATABASE_URL="postgresql://conversia:conversia_dev@localhost:5432/conversia_db?schema=public"
DIRECT_URL="postgresql://conversia:conversia_dev@localhost:5432/conversia_db?schema=public"
# Neon (production example):
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/conversia_db?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/conversia_db?sslmode=require&connect_timeout=15"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider: "anthropic" | "gemini"
AI_PROVIDER=anthropic
AI_MAX_RETRIES=2

# Anthropic Claude API (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini API (when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite

# Azure Cognitive Services (TTS/STT fallback)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Rate Limiting
RATE_LIMIT_GENERAL=60
RATE_LIMIT_AI=10
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Free Tier Limits
FREE_CHAT_SESSIONS_PER_DAY=10
FREE_PRACTICE_EXERCISES_PER_DAY=20
FREE_TRANSLATIONS_PER_DAY=5
FREE_MAX_SESSION_MINUTES=30
